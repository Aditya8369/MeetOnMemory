# Local development (HTTP — Express does not serve TLS)
VITE_BACKEND_URL=http://localhost:4000

# Production example
# VITE_BACKEND_URL=https://meetonmemory.onrender.com

# Required — Clerk publishable key (pk_test_… / pk_live_…)
VITE_CLERK_PUBLISHABLE_KEY=

# Issue #1335 — enable client-side transcript E2EE UI (AES-GCM via Web Crypto)
# Requires server E2EE_ENABLED=true as well.
VITE_E2EE_ENABLED=false
